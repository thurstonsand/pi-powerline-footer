{
  "name": "@thurstonsand/pi-powerline-footer",
  "version": "0.4.8",
  "description": "Powerline-style status bar extension for pi coding agent",
  "type": "module",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./index.ts"
    }
  },
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "test": "vitest --run",
    "build:types": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.types.json",
    "prepare": "npm run build:types"
  },
  "dependencies": {
    "@mariozechner/jiti": "^2.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@mariozechner/pi-ai": "^0.63.1",
    "@mariozechner/pi-coding-agent": "^0.63.1",
    "@mariozechner/pi-tui": "^0.63.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "files": [
    "autocomplete-bridge.ts",
    "autocomplete-registry.ts",
    "autocomplete-runtime.ts",
    "colors.ts",
    "custom.ts",
    "git-status.ts",
    "icons.ts",
    "index.ts",
    "json.ts",
    "presets.ts",
    "profiles.ts",
    "segment-registry.ts",
    "segments.ts",
    "separators.ts",
    "settings.ts",
    "theme.ts",
    "types.ts",
    "welcome.ts",
    "working-vibes.ts",
    "README.md",
    "LICENSE",
    "dist/**/*.d.ts"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "powerline",
    "status-bar",
    "extension"
  ],
  "author": "thurstonsand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thurstonsand/pi-powerline-footer.git"
  },
  "homepage": "https://github.com/thurstonsand/pi-powerline-footer#readme",
  "bugs": {
    "url": "https://github.com/thurstonsand/pi-powerline-footer/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
